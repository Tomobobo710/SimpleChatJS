{
  "name": "simplechatjs",
  "version": "0.6.0",
  "description": "Simple chat with MCP support - Electron app",
  "author": "SimpleChatJS",
  "main": "electron-main.js",
  "scripts": {
    "dev": "node scripts/run-electron.js",
    "build": "electron-builder --publish=never",
    "postinstall": "node scripts/fix-electron-sandbox.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "find-bar": "^0.1.3",
    "multer": "^2.2.0",
    "officeparser": "^6.0.7",
    "pdf-parse": "^2.4.5",
    "simple-git": "^3.36.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.simplechatjs.app",
    "productName": "SimpleChatJS",
    "icon": "assets/images/icon/simplechaticon512.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist-electron",
      "!*.bat",
      "!*.sh",
      "!*.ps1",
      "!build/**/*",
      "!package.json.backup",
      "!package-build.json"
    ],
    "win": {
      "target": {
        "target": "zip",
        "arch": [
          "x64"
        ]
      },
      "icon": "assets/images/icon/simplechaticon512.ico"
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "icon": "assets/images/icon/simplechaticon512.ico"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "icon": "assets/images/icon/simplechaticon512.ico"
    },
    "forceCodeSigning": false
  }
}
